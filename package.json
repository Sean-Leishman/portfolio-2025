{
    "name": "portfolio-2025",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build && react-snap",
        "lint": "eslint .",
        "preview": "vite preview"
    },
    "reactSnap": {
        "source": "dist",
        "destination": "dist",
        "crawl": true,
        "include": [
            "/",
            "/posts",
            "/projects"
        ],
        "puppeteerArgs": [
            "--no-sandbox",
            "--disable-setuid-sandbox",
            "--disable-dev-shm-usage",
            "--disable-accelerated-2d-canvas",
            "--no-first-run",
            "--no-zygote"
        ],
        "puppeteerExecutablePath": null,
        "skipThirdPartyRequests": true,
        "cacheAjaxRequests": false,
        "http2PushManifest": false,
        "chromeFlags": [
            "--disable-gpu",
            "--remote-debugging-port=9222",
            "--hide-scrollbars"
        ],
        "removeBlobs": true,
        "removeScriptTags": false,
        "asyncScriptTags": false
    },
    "dependencies": {
        "@mdx-js/react": "^3.1.0",
        "@tailwindcss/vite": "^4.1.11",
        "dotenv": "^17.2.1",
        "esbuild": "^0.25.8",
        "gray-matter": "^4.0.3",
        "mdx": "^0.3.1",
        "mdx-bundler": "^10.1.1",
        "node-gyp": "^11.2.0",
        "process": "^0.11.10",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-icons": "^5.5.0",
        "react-router-dom": "^7.7.0",
        "react-snap": "^1.23.0",
        "react-syntax-highlighter": "^15.6.1",
        "rehype-highlight": "^7.0.2",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "remark-mdx-frontmatter": "^5.2.0",
        "sonner": "^2.0.6",
        "tailwindcss": "^4.1.11"
    },
    "devDependencies": {
        "@eslint/js": "^9.30.1",
        "@mdx-js/mdx": "^3.1.0",
        "@mdx-js/rollup": "^3.1.0",
        "@tailwindcss/typography": "^0.5.16",
        "@types/node": "^24.1.0",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@vitejs/plugin-react": "^4.7.0",
        "eslint": "^9.30.1",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "globals": "^16.3.0",
        "tsx": "^4.20.3",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.35.1",
        "vite": "^7.0.6",
        "vite-plugin-ssr": "^0.4.142",
        "vite-plugin-static-copy": "^3.1.1"
    }
}
